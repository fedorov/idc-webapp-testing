{
  "name": "idc-webapp-testing",
  "version": "1.0.0",
  "description": "Automated testing for NCI Imaging Data Commons web portal",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "screenshot": "node scripts/viewer-screenshot.js",
    "gallery": "node scripts/viewer-gallery.js",
    "gallery:compare": "node scripts/build-comparison.js screenshots/production screenshots/testing screenshots/"
  },
  "keywords": [
    "testing",
    "playwright",
    "idc",
    "web-portal"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
